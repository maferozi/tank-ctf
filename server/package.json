{
  "name": "@tank/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/index.js",
    "start:ts": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx src/smoke.ts",
    "test": "tsx --test src/*.test.ts",
    "loadtest": "tsx src/loadtest.ts"
  },
  "dependencies": {
    "@tank/shared": "*",
    "colyseus": "^0.18.10",
    "node-datachannel": "^0.32.3"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.9",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "msgpackr": "^2.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
